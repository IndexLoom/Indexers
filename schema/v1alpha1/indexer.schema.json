{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://indexloom.org/schemas/indexer/v1alpha1/indexer.schema.json",
  "title": "IndexLoom indexer definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "provenance", "spec"],
  "properties": {
    "apiVersion": { "const": "indexloom.io/v1alpha1" },
    "kind": { "const": "Indexer" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "provenance": { "$ref": "#/$defs/provenance" },
    "spec": { "$ref": "#/$defs/spec" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "language"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "language": { "type": "string", "minLength": 2 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generatedBy", "source"],
      "properties": {
        "generatedBy": { "const": "indexloom-importer/v1" },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project",
        "repository",
        "revision",
        "path",
        "sourceId",
        "license",
        "fileSha256",
        "contentSha256"
      ],
      "properties": {
        "project": { "enum": ["jackett", "prowlarr-indexers"] },
        "repository": { "type": "string", "format": "uri", "pattern": "^https://github\\.com/" },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
        "sourceId": { "type": "string", "minLength": 1 },
        "license": { "const": "GPL-2.0-only" },
        "fileSha256": { "$ref": "#/$defs/sha256" },
        "contentSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "privacy", "baseUrls", "implementation"],
      "properties": {
        "protocol": { "const": "torrent" },
        "privacy": { "enum": ["public", "semi-private", "private"] },
        "baseUrls": { "$ref": "#/$defs/urlList" },
        "legacyUrls": { "$ref": "#/$defs/urlList" },
        "replacedIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "implementation": { "$ref": "#/$defs/cardigann" }
      }
    },
    "urlList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uri",
        "pattern": "^https?://"
      }
    },
    "cardigann": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "encoding", "capabilities", "settings", "search"],
      "properties": {
        "engine": { "const": "cardigann" },
        "encoding": { "type": "string", "minLength": 1 },
        "followRedirects": { "type": "boolean" },
        "testLinkTorrent": { "type": "boolean" },
        "requestDelaySeconds": { "type": "number", "minimum": 0 },
        "certificates": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "capabilities": { "type": "object" },
        "settings": {
          "type": "array",
          "items": { "type": "object" }
        },
        "authentication": { "type": "object" },
        "download": { "type": "object" },
        "search": { "type": "object", "minProperties": 1 }
      }
    }
  }
}
