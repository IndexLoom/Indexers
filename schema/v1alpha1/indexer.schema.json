{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://indexloom.org/schemas/indexer/v1alpha1/indexer.schema.json",
  "title": "IndexLoom indexer definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "indexloom.io/v1alpha1" },
    "kind": { "const": "Indexer" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "spec": { "$ref": "#/$defs/spec" }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "language": { "type": "string", "minLength": 2 }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["privacy", "baseUrls", "search"],
      "properties": {
        "privacy": { "enum": ["public", "semi-private", "private"] },
        "baseUrls": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          }
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "settings": {
          "type": "array",
          "items": { "$ref": "#/$defs/setting" }
        },
        "search": { "$ref": "#/$defs/search" }
      }
    },
    "setting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "type"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "label": { "type": "string", "minLength": 1 },
        "type": { "enum": ["text", "password", "boolean", "number"] },
        "required": { "type": "boolean", "default": false },
        "secret": { "type": "boolean", "default": false }
      }
    },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "path", "rows", "fields"],
      "properties": {
        "method": { "enum": ["GET", "POST"] },
        "path": { "type": "string", "pattern": "^/" },
        "inputs": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "rows": { "type": "string", "minLength": 1 },
        "fields": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/field" }
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selector"],
      "properties": {
        "selector": { "type": "string", "minLength": 1 },
        "attribute": { "type": "string", "default": "text" }
      }
    }
  }
}
